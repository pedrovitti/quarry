# IN: membership over a list, three-valued, with a NOT form. The truth table is
# stated as answers rather than as prose, so a row that disagrees names the
# case it broke.

statement ok
CREATE TABLE items (id INT, name TEXT, qty INT, price FLOAT)

statement ok
INSERT INTO items VALUES (1, 'apple', 3, 1.5), (2, 'banana', NULL, 0.5), (3, 'cherry', 7, 2.0), (4, NULL, 0, 4.25)

statement ok
CREATE TABLE stock (id INT, tally INT)

statement ok
INSERT INTO stock VALUES (1, 5), (2, 15), (3, 25), (4, NULL)

# Membership over a column with no NULL in it: the two forms partition the
# table between them.
query
SELECT id FROM items WHERE id IN (1, 3) ORDER BY id
----
id
1
3

query
SELECT id FROM items WHERE id NOT IN (1, 3) ORDER BY id
----
id
2
4

# One item is a list.
query
SELECT id FROM items WHERE id IN (2)
----
id
2

# The list is not a set: repeats and order change nothing.
query
SELECT id FROM items WHERE id IN (3, 1, 3) ORDER BY id
----
id
1
3

# A NULL on the left is unknown, and unknown does not pass a WHERE. Row 2 has
# no quantity, so it is in neither answer.
query
SELECT id FROM items WHERE qty IN (0, 3) ORDER BY id
----
id
1
4

query
SELECT id FROM items WHERE qty NOT IN (0, 3) ORDER BY id
----
id
3

# The truth table. A match wins over a NULL in the list; without a match the
# NULL is what decides, and the answer is unknown rather than false.
query
SELECT 1 IN (1, NULL) AS a, 1 IN (2, NULL) AS b, 1 IN (2, 3) AS c, NULL IN (1) AS d
----
a|b|c|d
true|NULL|false|NULL

# NOT IN is the negation of all four, which is why "1 NOT IN (2, NULL)" is not
# true: it is the case the classic bug returns rows for.
query
SELECT 1 NOT IN (1, NULL) AS a, 1 NOT IN (2, NULL) AS b, 1 NOT IN (2, 3) AS c, NULL NOT IN (1) AS d
----
a|b|c|d
false|NULL|true|NULL

# Numbers compare across kinds, as they do everywhere else.
query
SELECT 3 IN (1 + 2, 9) AS a, 2.0 IN (2) AS b, 2 IN (2.5) AS c, 2.5 IN (2.5) AS d
----
a|b|c|d
true|true|false|true

# Text compares with text.
query
SELECT id FROM items WHERE name IN ('apple', 'cherry') ORDER BY id
----
id
1
3

query
SELECT id FROM items WHERE name NOT IN ('apple') ORDER BY id
----
id
2
3

# The items are expressions over the row, not constants.
query
SELECT id FROM items WHERE id IN (qty, qty - 2) ORDER BY id
----
id
1

# An unknown left side never rescues a list that cannot be compared.
query
SELECT NULL IN ('x', 1) AS a
----
a
NULL

# A kind that could never compare is refused when the query is planned, not
# reported as no rows.
statement error cannot compare INT with TEXT
SELECT id FROM items WHERE id IN (1, 'x')

statement error cannot compare TEXT with INT
SELECT id FROM items WHERE name IN ('a', 2)

# The predicate is a value like any other: it can be selected, aliased, sorted
# on and negated.
query
SELECT id, id IN (1, 4) AS flagged FROM items ORDER BY flagged, id
----
id|flagged
2|false
3|false
1|true
4|true

query
SELECT id FROM items WHERE NOT id IN (1, 2) ORDER BY id
----
id
3
4

query
SELECT id FROM items WHERE id IN (1, 2) OR qty IN (7) ORDER BY id
----
id
1
2
3

# Unaliased, the heading is the predicate as it was written.
query
SELECT id IN (1, 2), id NOT IN (1, 2) FROM items WHERE id = 1
----
id IN (1, 2)|id NOT IN (1, 2)
true|false

# The predicate sits where a comparison sits, so it combines with the rest of
# the boolean vocabulary without parentheses.
query
SELECT id FROM items WHERE id IN (1, 2, 3) AND qty IN (3, 7) ORDER BY id
----
id
1
3

query
SELECT id FROM items WHERE NOT (id IN (1, 2) OR qty IN (7)) ORDER BY id
----
id
4

# And what it accepts on the way back out: a predicate inside a function call,
# inside parentheses, inside another predicate.
query
SELECT typeof(1 IN (1)) AS a, (1 IN (1)) IN (TRUE) AS b, coalesce(NULL IN (1), FALSE) AS c
----
a|b|c
BOOL|true|false

# DELETE and UPDATE reach the same predicates.
statement ok
UPDATE stock SET tally = 0 WHERE tally IN (15)

query
SELECT id, tally FROM stock ORDER BY id
----
id|tally
1|5
2|0
3|25
4|NULL

statement ok
DELETE FROM stock WHERE id IN (1, 4)

query
SELECT id, tally FROM stock ORDER BY id
----
id|tally
2|0
3|25

statement ok
DELETE FROM stock WHERE tally NOT IN (0)

query
SELECT id FROM stock ORDER BY id
----
id
2
