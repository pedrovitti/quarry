# A parenthesized SELECT in FROM is a table: its output columns are the
# columns, its alias is the table name, and nothing outside it is visible
# from inside.

statement ok
CREATE TABLE items (id INT, name TEXT, bin INT)

statement ok
INSERT INTO items VALUES (1, 'bolt', 10), (2, 'nut', 20), (3, 'washer', 10), (4, 'cap', NULL)

statement ok
CREATE TABLE bins (id INT, tag TEXT, cap INT)

statement ok
INSERT INTO bins VALUES (10, 'a', 2), (20, 'b', 1), (30, 'c', 9)

query
SELECT id FROM (SELECT id FROM bins) AS b ORDER BY id
----
id
10
20
30

# An inner alias renames the column, and the derived alias qualifies it.
query
SELECT b.small FROM (SELECT id AS small FROM bins WHERE cap > 1) AS b ORDER BY b.small
----
small
10
30

# The alias may also stand without AS, as any table alias may.
query
SELECT b.id FROM (SELECT id FROM bins WHERE tag = 'b') b
----
id
20

query
SELECT * FROM (SELECT tag, cap FROM bins WHERE id = 20) AS b
----
tag|cap
b|1

query
SELECT b.* FROM (SELECT id, tag FROM bins WHERE cap < 9) AS b ORDER BY b.id
----
id|tag
10|a
20|b

# An unaliased computed column is named by its expression, and the quoted
# name reaches it.
query
SELECT d."cap + 1" FROM (SELECT cap + 1 FROM bins WHERE id = 10) AS d
----
cap + 1
3

# A WHERE outside filters the rows the inner query produced.
query
SELECT id FROM (SELECT id, cap FROM bins WHERE cap > 1) AS b WHERE id > 10
----
id
30

query
SELECT items.id, big.tag FROM items JOIN (SELECT id, tag FROM bins WHERE cap >= 2) AS big ON items.bin = big.id ORDER BY items.id
----
id|tag
1|a
3|a

query
SELECT l.id, r.id FROM (SELECT id FROM bins WHERE cap > 1) AS l JOIN (SELECT id FROM bins WHERE tag <> 'c') AS r ON l.id = r.id
----
id|id
10|10

query
SELECT id FROM (SELECT id FROM (SELECT id, cap FROM bins) AS x WHERE cap > 1) AS y ORDER BY id
----
id
10
30

# A subquery written inside the derived table still correlates to the derived
# table's own FROM, as it would anywhere.
query
SELECT d.id FROM (SELECT id FROM bins WHERE id IN (SELECT bin FROM items WHERE items.bin = bins.id)) AS d ORDER BY d.id
----
id
10
20

# The inner query is a whole select: ordering, limits and DISTINCT inside all
# act before the rows become a table.
query
SELECT id FROM (SELECT id FROM bins ORDER BY id DESC LIMIT 2) AS b ORDER BY id
----
id
20
30

query
SELECT b FROM (SELECT DISTINCT bin AS b FROM items WHERE bin = 10) AS d
----
b
10

query
SELECT id FROM items WHERE bin IN (SELECT id FROM (SELECT id, cap FROM bins WHERE cap < 9) AS small) ORDER BY id
----
id
1
2
3

query
SELECT * FROM (SELECT 1 AS one, 'x' AS tag) AS d
----
one|tag
1|x

query
SELECT (SELECT id FROM (SELECT id FROM bins WHERE tag = 'b') AS d) AS a
----
a
20

# The name is not optional.
statement error a subquery in FROM needs a name
SELECT id FROM (SELECT id FROM bins)

statement error a subquery in FROM needs a name
SELECT items.id FROM items JOIN (SELECT id FROM bins) ON items.bin = id

# Nothing outside the parentheses is visible inside them.
statement error no column "items.bin"
SELECT id FROM items WHERE bin IN (SELECT v FROM (SELECT cap AS v FROM bins WHERE bins.id = items.bin) AS d)

statement error column "id" is ambiguous
SELECT id FROM (SELECT id FROM bins) AS a JOIN (SELECT id FROM bins) AS b ON a.id = b.id

statement error cannot compare INT with TEXT
SELECT id FROM items WHERE bin IN (SELECT t FROM (SELECT tag AS t FROM bins) AS d)
