# Projection, filtering, ordering and paging over one table.

statement ok
CREATE TABLE customers (id INT NOT NULL, name TEXT, city TEXT, spend FLOAT)

statement ok
INSERT INTO customers VALUES
  (1, 'ada', 'london', 1250.5),
  (2, 'bob', 'paris', 89.0),
  (3, 'cy', 'london', 4300.25),
  (4, 'dee', NULL, 12.0)

query
SELECT * FROM customers
----
id|name|city|spend
1|ada|london|1250.5
2|bob|paris|89.0
3|cy|london|4300.25
4|dee|NULL|12.0

query
SELECT name FROM customers
----
name
ada
bob
cy
dee

query
SELECT city, id FROM customers WHERE id = 1
----
city|id
london|1

# Selecting the same column twice is allowed and keeps both positions.
query
SELECT id, id FROM customers WHERE id = 2
----
id|id
2|2

query
SELECT name AS who FROM customers WHERE id = 3
----
who
cy

query
SELECT customers.name FROM customers WHERE id = 1
----
name
ada

# A computed column is labelled with the expression that produced it.
query
SELECT id * 10 FROM customers WHERE id = 2
----
id * 10
20

query
SELECT id * 10 AS scaled FROM customers WHERE id = 2
----
scaled
20

# A SELECT with no FROM runs over a single empty row.
query
SELECT 1
----
1
1

query
SELECT 1 + 2 * 3
----
1 + 2 * 3
7

query
SELECT (1 + 2) * 3
----
(1 + 2) * 3
9

statement ok
CREATE TABLE ints (a INT, b INT)

statement ok
INSERT INTO ints VALUES (7, 2), (-7, 2), (0, 5)

# Integer division truncates toward zero and keeps its type.
query
SELECT a, b, a / b, a % b FROM ints ORDER BY a DESC
----
a|b|a / b|a % b
7|2|3|1
0|5|0|0
-7|2|-3|-1

# Mixing an integer with a float widens the result.
query
SELECT 1 + 0.5
----
1 + 0.5
1.5

query
SELECT typeof(1), typeof(1.0), typeof('a'), typeof(TRUE), typeof(NULL)
----
typeof(1)|typeof(1.0)|typeof('a')|typeof(TRUE)|typeof(NULL)
INT|FLOAT|TEXT|BOOL|NULL

query
SELECT id FROM customers WHERE city = 'london'
----
id
1
3

query
SELECT id FROM customers WHERE spend > 100 AND city = 'london'
----
id
1
3

query
SELECT id FROM customers WHERE id = 1 OR id = 4
----
id
1
4

query
SELECT id FROM customers WHERE NOT id = 1
----
id
2
3
4

query
SELECT id FROM customers WHERE id = 99
----
id

query
SELECT name FROM customers ORDER BY name DESC
----
name
dee
cy
bob
ada

query
SELECT spend FROM customers ORDER BY spend
----
spend
12.0
89.0
1250.5
4300.25

# ORDER BY may name a column that is not selected.
query
SELECT name FROM customers ORDER BY spend DESC
----
name
cy
ada
bob
dee

# It may also name an output alias.
query
SELECT name AS who FROM customers ORDER BY who DESC
----
who
dee
cy
bob
ada

query
SELECT city, name FROM customers ORDER BY city DESC, name DESC
----
city|name
paris|bob
london|cy
london|ada
NULL|dee

query
SELECT id FROM customers ORDER BY id LIMIT 2
----
id
1
2

query
SELECT id FROM customers ORDER BY id LIMIT 2 OFFSET 1
----
id
2
3

query
SELECT id FROM customers ORDER BY id OFFSET 3
----
id
4

query
SELECT id FROM customers LIMIT 0
----
id

query
SELECT DISTINCT city FROM customers ORDER BY city
----
city
NULL
london
paris
