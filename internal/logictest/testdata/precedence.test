# Operator precedence and associativity, stated as answers rather than as a
# table. Each case is a pair: the expression as written, and the same
# expression with the grouping the parser should have chosen made explicit.
# If the two ever disagree, precedence has moved.

# * binds tighter than +.
query
SELECT 1 + 2 * 3, (1 + 2) * 3, 1 + (2 * 3)
----
1 + 2 * 3|(1 + 2) * 3|1 + (2 * 3)
7|9|7

query
SELECT 10 - 2 * 3, 2 * 3 + 10, 100 / 10 / 2
----
10 - 2 * 3|2 * 3 + 10|100 / 10 / 2
4|16|5

# / and % share a level with *, and all three are left associative, so
# 100 / 10 / 2 is 5 rather than 20.
query
SELECT 100 / (10 / 2), 7 % 4 * 2, 7 % (4 * 2)
----
100 / (10 / 2)|7 % 4 * 2|7 % (4 * 2)
20|6|7

# - is left associative too: 10 - 3 - 2 is 5, not 9.
query
SELECT 10 - 3 - 2, 10 - (3 - 2)
----
10 - 3 - 2|10 - (3 - 2)
5|9

# Unary minus binds tighter than any infix operator.
query
SELECT -2 + 3, -(2 + 3), -2 * 3, 2 - -3
----
-2 + 3|-(2 + 3)|-2 * 3|2 - -3
1|-5|-6|5

# || sits below arithmetic, so 'n=' || 1 + 2 adds before it joins. The join
# then fails, because || does not read a number as text - which is the same
# fact stated from the other side: had || bound tighter, the error would have
# been about adding 2 to a string.
statement error || needs text, got TEXT and INT
SELECT 'n=' || 1 + 2

query
SELECT 'n=' || upper('x')
----
'n=' || upper('x')
n=X

# It is left associative, which for concatenation only shows in the grouping.
query
SELECT 'a' || 'b' || 'c', ('a' || 'b') || 'c', 'a' || ('b' || 'c')
----
'a' || 'b' || 'c'|('a' || 'b') || 'c'|'a' || ('b' || 'c')
abc|abc|abc

# Comparison is below ||, so the strings are joined before being compared.
query
SELECT 'a' || 'b' = 'ab'
----
'a' || 'b' = 'ab'
true

# Comparison is below arithmetic: 1 + 1 = 2 compares the sum, and does not add
# 1 to the truth of 1 = 2.
query
SELECT 1 + 1 = 2, 2 * 3 > 5, 10 - 1 <> 9
----
1 + 1 = 2|2 * 3 > 5|10 - 1 <> 9
true|true|false

statement ok
CREATE TABLE flags (id INT, a BOOL, b BOOL, c BOOL)

statement ok
INSERT INTO flags VALUES
  (1, TRUE, TRUE, TRUE),
  (2, TRUE, FALSE, FALSE),
  (3, FALSE, TRUE, FALSE),
  (4, FALSE, FALSE, TRUE)

# AND binds tighter than OR, so "a OR b AND c" keeps row 2: a is true.
query
SELECT id FROM flags WHERE a OR b AND c ORDER BY id
----
id
1
2

# With the grouping the other way round, row 2 goes: b AND c is false there.
query
SELECT id FROM flags WHERE (a OR b) AND c ORDER BY id
----
id
1

# NOT sits between AND and comparison. That is what makes "NOT a = 1" mean
# "NOT (a = 1)" rather than "(NOT a) = 1", which would not even type check.
query
SELECT id FROM flags WHERE NOT id = 1 ORDER BY id
----
id
2
3
4

# And "NOT a AND b" is "(NOT a) AND b": row 3 has a false and b true.
query
SELECT id FROM flags WHERE NOT a AND b ORDER BY id
----
id
3

query
SELECT id FROM flags WHERE NOT (a AND b) ORDER BY id
----
id
2
3
4

# Two NOTs cancel.
query
SELECT id FROM flags WHERE NOT NOT a ORDER BY id
----
id
1
2

# IS NULL is at the comparison level, so the arithmetic under it runs first.
query
SELECT 1 + 1 IS NULL, NULL + 1 IS NULL
----
1 + 1 IS NULL|NULL + 1 IS NULL
false|true

# Parentheses survive into the column label, which is how these cases stay
# readable when one of them fails.
query
SELECT (1)
----
(1)
1
